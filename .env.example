# Copy to .env (optional). The app works with none of these set.

# Optional: lets the chat assistant answer general questions with the Claude API.
# Navigation, medicine lookups and interaction checks never need it.
ANTHROPIC_API_KEY=
# MEDSAFE_LLM_MODEL=claude-sonnet-4-6

# Optional: full path to tesseract.exe if it is not found automatically
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional: SQLite file location (default data/medsafe.db)
# MEDSAFE_DB=data/medsafe.db
